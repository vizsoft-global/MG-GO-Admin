{
  "name": "dpd-admin-functions",
  "description": "Cloud Functions for the DPD Control Tower — ports of the admin RPCs (musallam-delivery-prod).",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "dpdadmin": "file:..",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
