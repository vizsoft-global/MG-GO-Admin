# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (root and nested package builds)
.next/
/.next-old-*/
/out/

# stale git copy (do not commit)
/.git.broken/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# firebase secrets (client config templates live under docs/firebase/)
/config/
/probe-*.mjs

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
.env.sentry-build-plugin

# Graphify generated knowledge graph (regenerated locally)
graphify-out/

# Local language preference (Kannada responses) — keep private
.cursor/rules/KA.mdc

.vercel

.qa/

# Local Figma QA dumps / screenshots (do not commit)
.figma-*/
.tmp-figma/
.eslint-visits.json
qa-esign-*.png

# Local Miniflare / wrangler state (never commit)
.wrangler/

# local deploy/debug artifacts
.tmp-*
firebase-debug.log

# local dev / QA scratch output (never commit)
/*.log
/tscg.*

# firebase CLI deploy overrides (a local subset of firebase.json, never shipped)
firebase.deployonly.json

# Agent tooling state — regenerated per machine, not part of the product
.serena/cache/
.serena/project.local.yml
.agents/mcp/

# function signer key (local).fn-signer.json
