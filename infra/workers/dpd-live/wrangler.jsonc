{
  "name": "dpd-live",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  // No nodejs_compat: token HMAC and hashing use Web Crypto, which is native here.
  "account_id": "04c485faa34d67d1758b61465202e9ce",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FLEET",
        "class_name": "FleetRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FleetRoom"]
    }
  ],
  "vars": {
    // Sharding key. One room holds the whole Kuwait fleet today; the key is a
    // parameter from day one so 500 -> 5000 drivers is a config change.
    "FLEET_ROOM": "fleet-kw",
    "POSITION_FRAME_HZ": "4",
    "POSTGRES_FLUSH_MS": "10000",
    "BROADCAST_MIRROR_MS": "1000",
    "TICK_MS": "2000",
    "FIREBASE_PROJECT_ID": "musallam-delivery-prod",
    "FIREBASE_FUNCTIONS_BASE_URL": "https://me-central1-musallam-delivery-prod.cloudfunctions.net",
    // GPS history sink. "r2" + a percent routes that share of riders' history into
    // R2 (FleetRoom SQLite -> minute files -> hourly per-rider objects) instead of
    // driver_location_events. "off" keeps every rider on Firestore.
    "GPS_SINK": "r2",
    "GPS_SINK_PERCENT": "100",
    // Cut over 2026-10-19 after the full-day R2 export and all-rider compare.
    // Keep "1" only for a future rollback window; Firestore history is now read
    // through app_settings.location_gps_r2_since.
    "GPS_DUAL_WRITE": "0"
  },
  "r2_buckets": [
    {
      "binding": "GPS_ARCHIVE",
      "bucket_name": "dpd-gps-prod"
    }
  ],
  "env": {
    "testing": {
      "name": "dpd-live-testing",
      "durable_objects": {
        "bindings": [
          {
            "name": "FLEET",
            "class_name": "FleetRoom"
          }
        ]
      },
      "vars": {
        "FLEET_ROOM": "fleet-kw-testing",
        "POSITION_FRAME_HZ": "4",
        "POSTGRES_FLUSH_MS": "10000",
        "BROADCAST_MIRROR_MS": "1000",
        "TICK_MS": "2000",
        "FIREBASE_PROJECT_ID": "musallam-delivery-prod",
        "FIREBASE_FUNCTIONS_BASE_URL": "https://me-central1-musallam-delivery-prod.cloudfunctions.net"
      }
    }
  }
}
